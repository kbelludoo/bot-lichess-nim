[Unit]
Description=Lichess Bot Native Nim (Berserk Mode + MBVM-DB Auto-Learn)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/chess-bot
ExecStart=/home/ubuntu/chess-bot/bot-lichess-linux-nim -config /home/ubuntu/chess-bot/bot-config.json
Restart=always
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
